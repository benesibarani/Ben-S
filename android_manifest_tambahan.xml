<!--
================================================================================
RTS Panel By Bene
TAMBAHAN IZIN UNTUK ANDROID
================================================================================

Berkas ini BUKAN berkas utuh. Hanya berisi baris-baris yang perlu ditambahkan
pada AndroidManifest.xml di komputer Anda.

Lokasi berkas:
  D:\Project\rts_panel_app\android\app\src\main\AndroidManifest.xml

Caranya:
  1. Buka AndroidManifest.xml
  2. Cari baris yang berisi:  <application
  3. Tempelkan baris <uses-permission> di bawah ini TEPAT DI ATAS baris
     <application>
  4. Simpan

Catatan:
  - Jangan menempelkan komentar ini. Cukup baris <uses-permission> saja.
  - Baris <uses-permission> lain yang sudah ada (misalnya INTERNET) tidak
    perlu diubah dan tidak perlu dihapus.
  - Bila baris LOCATION di bawah sudah ada di berkas Anda, tidak perlu
    ditambahkan lagi (jangan sampai dua kali).
-->

<!-- Izin membaca titik lokasi untuk mengisi alamat dari koordinat (Ganti Alamat) -->
<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

<!-- Izin menampilkan pemberitahuan pada layar HP (Android 13 ke atas) -->
<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

<!-- Izin kamera, dipakai saat petugas mengambil foto pribadi dari kamera.
     Memilih foto dari galeri TIDAK memerlukan izin tambahan. -->
<uses-permission android:name="android.permission.CAMERA" />

<!-- Izin memasang pembaruan LANGSUNG DARI DALAM APLIKASI (Android 8 ke atas).
     Tanpa izin ini, Android hanya mengizinkan pemasangan lewat peramban
     (Chrome). Izin ini tetap meminta persetujuan petugas sekali saja: saat
     pertama kali menekan Pasang, Android menampilkan halaman pengaturan
     "Instal aplikasi tidak dikenal" - setelah diizinkan, pembaruan berikutnya
     berjalan sendiri. -->
<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

<!-- Izin Bluetooth untuk PRINTER STRUK (fitur PRO Barang Bawaan & Kasir).
     Dua baris pertama hanya dipakai Android 11 ke bawah; dua baris berikutnya
     dipakai Android 12 ke atas. Semuanya boleh ditulis sekaligus - Android
     memilih sendiri yang sesuai dengan versi HP.

     Catatan Android 12 ke atas: saat pertama kali menekan tombol "SAMBUNG",
     Android menampilkan permintaan izin "Perangkat di sekitar" - tekan
     IZINKAN. -->
<uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
<uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
<uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
<uses-permission android:name="android.permission.BLUETOOTH_SCAN"
    android:usesPermissionFlags="neverForLocation" />

<!-- Keterangan: izin KAMERA di atas juga dipakai untuk MEMINDAI BARCODE produk
     pada menu Kasir, bukan hanya mengambil foto pribadi. -->

<!-- Agar aplikasi tetap dapat dipasang pada HP tanpa kamera. -->
<uses-feature android:name="android.hardware.camera" android:required="false" />
<uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

